{
  "name": "corvus-ws",
  "version": "1.0.7",
  "description": "An independently built WhatsApp bot library",
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-bot",
    "multi-device",
    "typescript",
    "websocket"
  ],
  "license": "MIT",
  "author": "AstraCodeX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astra-Devl/corvus-ws.git"
  },
  "type": "module",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./proto": {
      "types": "./dist/types/proto/index.d.ts",
      "import": "./dist/esm/proto/index.js",
      "require": "./dist/cjs/proto/index.js"
    },
    "./WAProto": {
      "types": "./WAProto/index.d.ts",
      "default": "./WAProto/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "WAProto",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "node scripts/build.cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "typecheck": "tsc -p tsconfig.types.json --noEmit",
    "lint": "eslint src proto tests",
    "lint:fix": "eslint src proto tests --fix",
    "format": "prettier --write src proto tests",
    "format:check": "prettier --check src proto tests",
    "proto:generate": "tsx scripts/generate-proto.cjs",
    "proto:validate": "tsx scripts/validate-proto.cjs",
    "test": "npm run test:unit && npm run test:proto && npm run test:version && npm run test:integration && npm run test:pairing && npm run test:lid && npm run test:buttons",
    "test:unit": "tsx tests/utils/utils-and-internal.smoke.mts",
    "test:proto": "tsx tests/proto/proto.smoke.mts",
    "test:version": "tsx tests/version/version.smoke.mts",
    "test:integration": "tsx tests/integration/make-socket.smoke.mts",
    "check": "npm run lint && npm run typecheck && npm run proto:validate && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "test:pairing": "tsx tests/integration/pairing-handshake.smoke.mts",
    "test:lid": "tsx tests/integration/lid-support.smoke.mts",
    "test:buttons": "tsx tests/integration/buttons.smoke.mts"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.0",
    "ws": "^8.18.0"
  }
}
